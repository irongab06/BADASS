# Reseau de transport.
auto eth0
iface eth0 inet static
    address 10.1.1.2
    netmask 255.255.255.0

    # Interface vers l'hote.
    up /sbin/ip link set eth1 up

    # Bridge Ethernet.
    up /sbin/ip link add br0 type bridge

    # Tunnel VXLAN statique vers le routeur 1.
    up /sbin/ip link add vxlan10 type vxlan id 10 local 10.1.1.2 remote 10.1.1.1 dev eth0 dstport 4789
    up /sbin/ip link set eth1 master br0
    up /sbin/ip link set vxlan10 master br0
    up /sbin/ip link set vxlan10 up
    up /sbin/ip link set br0 up
